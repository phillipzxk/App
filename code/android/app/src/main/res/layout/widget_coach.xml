<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wurzel"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="14dp" android:background="@drawable/widget_dunkel">
    <TextView android:id="@+id/kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Dein Coach" android:textAllCaps="true" android:letterSpacing="0.12" android:textSize="9sp"
        android:fontFamily="@font/figtree_semibold" android:textColor="#E6C98F" android:maxLines="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <ImageView android:id="@+id/kopf" android:layout_width="46dp" android:layout_height="46dp" android:scaleType="centerCrop"/>
        <TextView android:id="@+id/titel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:textSize="14sp" android:fontFamily="@font/sora_bold"
            android:textColor="#F6ECDB" android:maxLines="4" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="bottom">
        <TextView android:id="@+id/unter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="11sp" android:fontFamily="@font/figtree_regular" android:textColor="#BFF6ECDB"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/knopf" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:background="@drawable/widget_pille_hell" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:textSize="11sp" android:fontFamily="@font/figtree_semibold" android:textColor="#2A1F14"/>
    </LinearLayout>
</LinearLayout>
